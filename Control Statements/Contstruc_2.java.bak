public class Contstruc_2{
    public static void main(String args[]){
	
	int day = 3:
	String dayname
	
	switch (day) {
	    case 1:
		    dayname = "Monday";
			break;
		case 2:
		    dayname = "Tuesday";
			break;
		case 3:
		    dayname = "Wednesday";
			break;
		default:
		    dayname = "Invalidday";
	};
	
	    System.out.println(dayname);
	}
}